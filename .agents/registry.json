{
    "version": "2.3.0",
    "project_name": "elite-agent-bootstrap",
    "description": "Registro oficial y catálogo de gobernanza de agentes de IA para Elite Agent Bootstrap v2 (con soporte para memoria persistente, Starter Pack de Skills y MCPs esenciales)",
    "governance_source": ".specify/memory/constitution.md",
    "default_decision_provider": "deterministic",
    "agents": [
        {
            "id": "orchestrator",
            "name": "Orquestador Principal",
            "description": "Coordina el flujo de trabajo SDD, asigna tareas entre agentes y gestiona el estado global y memoria del proyecto.",
            "role": "orchestrator",
            "capabilities": [
                "routing",
                "state-management",
                "task-dispatching",
                "phase-coordination",
                "memory-read",
                "memory-write",
                "memory-maintenance"
            ],
            "tools": ["git", "speckit-cli", "github-mcp", "context7-mcp"],
            "skills": ["speckit-sdd", "find-skills", "grill-me"],
            "inputs": ["user_request", "project_status"],
            "outputs": ["phase_plan", "handoff_dispatch"],
            "allowed_files": [".agents/**", "PROJECT_LOG.md", "README.md", "MEMORY.md"],
            "forbidden_files": ["src/**", "app/**", ".specify/memory/constitution.md"],
            "dependencies": [],
            "risk_level": "medium",
            "requires_human_approval": false,
            "can_delegate": true,
            "can_modify_code": false,
            "can_modify_specs": true,
            "can_modify_governance": false,
            "can_commit": true,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        },
        {
            "id": "spec-agent",
            "name": "Especialista en Especificaciones (SpecAgent)",
            "description": "Redacta, audita y mantiene especificaciones funcionales (spec.md), planes técnicos (plan.md), listas de tareas (tasks.md) y decisiones operativas.",
            "role": "spec-agent",
            "capabilities": [
                "requirements-analysis",
                "bdd-specifications",
                "architecture-planning",
                "task-breakdown",
                "memory-read",
                "memory-write"
            ],
            "tools": ["speckit-cli", "context7-mcp", "figma-mcp"],
            "skills": ["speckit-sdd", "grill-me", "find-skills"],
            "inputs": ["requirements", "clarifications"],
            "outputs": ["spec.md", "plan.md", "tasks.md"],
            "allowed_files": [
                "specs/**",
                ".specify/templates/**",
                "MEMORY.md",
                ".agents/memory/decisions.md",
                ".agents/memory/context.md"
            ],
            "forbidden_files": ["src/**", "app/**", "tests/**", ".specify/memory/constitution.md"],
            "dependencies": ["orchestrator"],
            "risk_level": "low",
            "requires_human_approval": false,
            "can_delegate": false,
            "can_modify_code": false,
            "can_modify_specs": true,
            "can_modify_governance": false,
            "can_commit": true,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        },
        {
            "id": "implementer",
            "name": "Ingeniero de Implementación (Implementer)",
            "description": "Desarrolla código de producción guiado por tareas específicas en tasks.md siguiendo metodología TDD y registra patrones y lecciones de código.",
            "role": "implementer",
            "capabilities": [
                "code-generation",
                "refactoring",
                "tdd-cycle",
                "dependency-wiring",
                "memory-read",
                "memory-write"
            ],
            "tools": [
                "terminal",
                "editor-tools",
                "linter",
                "chrome-devtools-mcp",
                "supabase-mcp",
                "figma-mcp",
                "context7-mcp"
            ],
            "skills": [
                "speckit-sdd",
                "frontend-design",
                "web-design-guidelines",
                "systematic-debugging"
            ],
            "inputs": ["tasks.md", "plan.md"],
            "outputs": ["source_code", "implementation_evidence"],
            "allowed_files": [
                "src/**",
                "app/**",
                "lib/**",
                "bin/**",
                ".agents/memory/patterns.md",
                ".agents/memory/lessons.md"
            ],
            "forbidden_files": [
                ".specify/memory/constitution.md",
                ".github/workflows/**",
                "specs/**"
            ],
            "dependencies": ["spec-agent"],
            "risk_level": "medium",
            "requires_human_approval": false,
            "can_delegate": false,
            "can_modify_code": true,
            "can_modify_specs": false,
            "can_modify_governance": false,
            "can_commit": true,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        },
        {
            "id": "tester",
            "name": "Ingeniero de Pruebas y QA (TestingAgent)",
            "description": "Diseña y ejecuta pruebas unitarias, de integración y end-to-end, asegurando la cobertura y el ciclo RED-GREEN, y persiste lecciones de testing.",
            "role": "tester",
            "capabilities": [
                "unit-testing",
                "integration-testing",
                "test-coverage",
                "regression-testing",
                "memory-read",
                "memory-write"
            ],
            "tools": [
                "vitest",
                "jest",
                "pytest",
                "playwright",
                "chrome-devtools-mcp",
                "supabase-mcp"
            ],
            "skills": ["speckit-sdd", "systematic-debugging", "web-design-guidelines"],
            "inputs": ["spec.md", "source_code"],
            "outputs": ["test_files", "coverage_report"],
            "allowed_files": [
                "tests/**",
                "spec/**",
                "**/*.test.*",
                "**/*.spec.*",
                ".agents/memory/lessons.md",
                ".agents/memory/patterns.md"
            ],
            "forbidden_files": [
                "src/**",
                ".specify/memory/constitution.md",
                ".github/workflows/**"
            ],
            "dependencies": ["implementer"],
            "risk_level": "low",
            "requires_human_approval": false,
            "can_delegate": false,
            "can_modify_code": true,
            "can_modify_specs": false,
            "can_modify_governance": false,
            "can_commit": true,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        },
        {
            "id": "security-agent",
            "name": "Auditor de Seguridad y Políticas (SecurityAgent)",
            "description": "Audita el código contra vulnerabilidades OWASP para agentes, inyección de prompts, exposición de secretos y licencias, registrando lecciones de seguridad.",
            "role": "security-agent",
            "capabilities": [
                "owasp-audit",
                "secret-scanning",
                "dependency-vulnerability-check",
                "least-privilege-audit",
                "memory-read",
                "memory-write"
            ],
            "tools": ["git", "npm-audit", "secret-scanner", "github-mcp"],
            "skills": ["speckit-sdd", "systematic-debugging"],
            "inputs": ["source_code", "pull_request"],
            "outputs": ["security_audit_report"],
            "allowed_files": [".evidence/**", "docs/security/**", ".agents/memory/lessons.md"],
            "forbidden_files": ["src/**", "package.json", ".specify/memory/constitution.md"],
            "dependencies": ["implementer"],
            "risk_level": "low",
            "requires_human_approval": false,
            "can_delegate": false,
            "can_modify_code": false,
            "can_modify_specs": false,
            "can_modify_governance": false,
            "can_commit": false,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        },
        {
            "id": "reviewer",
            "name": "Revisor Técnico y Puerta de Calidad (ReviewerAgent)",
            "description": "Evalúa de forma independiente las soluciones generadas contra la especificación y criterios de aceptación, validando promociones de memoria.",
            "role": "reviewer",
            "capabilities": [
                "code-review",
                "acceptance-criteria-verification",
                "compliance-check",
                "memory-read"
            ],
            "tools": ["git", "gh-cli", "github-mcp", "chrome-devtools-mcp"],
            "skills": ["speckit-sdd", "web-design-guidelines", "frontend-design", "grill-me"],
            "inputs": ["spec.md", "pull_request", "evidence"],
            "outputs": ["review_verdict"],
            "allowed_files": [".evidence/**", "specs/**"],
            "forbidden_files": ["src/**", ".specify/memory/constitution.md", ".agents/memory/**"],
            "dependencies": ["tester", "security-agent"],
            "risk_level": "medium",
            "requires_human_approval": true,
            "can_delegate": false,
            "can_modify_code": false,
            "can_modify_specs": false,
            "can_modify_governance": false,
            "can_commit": false,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": false
        },
        {
            "id": "optimization-agent",
            "name": "Especialista en Optimización y Rendimiento (OptimizationAgent)",
            "description": "Analiza el tamaño de los artefactos de compilación, latencias, cuellos de botella y eficiencia de memoria, registrando patrones de optimización.",
            "role": "optimization-agent",
            "capabilities": [
                "bundle-analysis",
                "performance-profiling",
                "memory-leak-detection",
                "memory-read",
                "memory-write"
            ],
            "tools": ["bundle-analyzer", "lighthouse", "chrome-devtools-mcp"],
            "skills": ["speckit-sdd", "web-design-guidelines"],
            "inputs": ["build_artifacts"],
            "outputs": ["performance_audit_report"],
            "allowed_files": [
                ".evidence/**",
                "docs/performance/**",
                ".agents/memory/patterns.md",
                ".agents/memory/lessons.md"
            ],
            "forbidden_files": ["src/**", ".specify/memory/constitution.md"],
            "dependencies": ["implementer"],
            "risk_level": "low",
            "requires_human_approval": false,
            "can_delegate": false,
            "can_modify_code": false,
            "can_modify_specs": false,
            "can_modify_governance": false,
            "can_commit": false,
            "can_merge": false,
            "can_read_memory": true,
            "can_write_memory": true
        }
    ]
}
